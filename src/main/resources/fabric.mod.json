{
  "schemaVersion": 1,
  "id": "fabric-discord-notifier",
  "version": "${version}",
  "name": "fabric-discord-notifier",
  "description": "Simple mod that sends notifications about server events to discord.",
  "authors": [
    "Roy Westerhof"
  ],
  "contact": {
    "homepage": "roy-it.nl",
    "sources": "https://github.com/WesterhofRoy/fabric-discord-notifier"
  },
  "license": "Apache 2.0",
  "icon": "assets/fabric-discord-notifier/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      {
        "value": "nl.royit.fabricdiscordnotifier.FabricDiscordNotifier",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1 <26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}